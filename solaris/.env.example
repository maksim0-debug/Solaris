# Google OAuth2 Credentials
# Get these from Google Cloud Console (Desktop App)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here


# Mapbox Token
# Get this from Mapbox (Standard Public Token)
MAPBOX_TOKEN=pk.your_mapbox_token_here

# WeatherAPI Key
# Get this from WeatherAPI.com (Free Plan)
WEATHER_API_KEY=your_weather_api_key_here

# Release Flag
# Set to 'true' for official GitHub Releases (enables auto-update by default), 
# or 'false' for custom/local builds (disables auto-update by default to protect saved API keys 
# from being reset due to DPAPI_ENTROPY mismatch between custom and official releases).
IS_OFFICIAL_RELEASE=false

# Windows DPAPI Optional Entropy (for additional encryption protection)
DPAPI_ENTROPY=your_custom_entropy_salt_here
